package com.smartcast.live.audio

import android.media.audiofx.AcousticEchoCanceler
import android.media.audiofx.AutomaticGainControl
import android.media.audiofx.NoiseSuppressor

object AudioEffectsManager {
    private var echo: AcousticEchoCanceler? = null
    private var noise: NoiseSuppressor? = null
    private var gain: AutomaticGainControl? = null

    @Synchronized
    fun attachEffects(sessionId: Int) {
        release()
        if (sessionId <= 0) return
        try {
            if (AcousticEchoCanceler.isAvailable()) {
                echo = AcousticEchoCanceler.create(sessionId)?.also { it.enabled = true }
            }
        } catch (_: Exception) {}
        try {
            if (NoiseSuppressor.isAvailable()) {
                noise = NoiseSuppressor.create(sessionId)?.also { it.enabled = true }
            }
        } catch (_: Exception) {}
        try {
            if (AutomaticGainControl.isAvailable()) {
                gain = AutomaticGainControl.create(sessionId)?.also { it.enabled = true }
            }
        } catch (_: Exception) {}
    }

    @Synchronized
    fun release() {
        try { echo?.release() } catch (_: Exception) {}
        try { noise?.release() } catch (_: Exception) {}
        try { gain?.release() } catch (_: Exception) {}
        echo = null
        noise = null
        gain = null
    }
}
